# Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.

# ---- Sanity CMS (required once Sanity integration begins) ----
# Found in your Sanity project dashboard (sanity.io/manage)
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read token: only needed if fetching unpublished/draft content
SANITY_READ_TOKEN=
# Write token: only needed for scripts that write content programmatically
# Keep this one especially secret — it can modify your content.
SANITY_WRITE_TOKEN=

# ---- Site configuration ----
# Centralizes the domain so it is never hard-coded throughout the app
SITE_URL=https://www.hibamuzammilqadri.com

# ---- Contact form (if/when a real form replaces the mailto: link) ----
CONTACT_FORM_RECIPIENT_EMAIL=hibamuzammilqadri11@gmail.com
# e.g. if using a form-relay service later
# CONTACT_FORM_SERVICE_API_KEY=

# ---- Analytics (if/when added) ----
# ANALYTICS_ID=
